<Project Sdk="Microsoft.NET.Sdk">
  <!-- A typed HttpClient for the Infinite Spartan Render API (POST /spartans, /spartan-sets). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>PlayGrifball.InfiniteSpartanRender.Client</RootNamespace>
    <PackageId>PlayGrifball.InfiniteSpartanRender.Client</PackageId>
    <Version>0.0.0.1-beta</Version>
    <Authors>PlayGrifball</Authors>
    <Description>.NET client for the Infinite Spartan Render API: ask for a Halo Infinite Spartan as a PNG or GLB and download the result.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/PlayGrifball/infinite-spartan-render</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PlayGrifball/infinite-spartan-render</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>halo,halo-infinite,spartan,render,glb,api-client</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="all" />
  </ItemGroup>
</Project>
